function talkCard(who,portraitHtml,text,mine=false,action=null){return `<${action?'button':'div'} class="talk-card ${mine?'mine':'other'}" ${action?`data-action="${action}"`:''}><div class="talk-avatar">${portraitHtml}<strong>${esc(who)}</strong></div><p>${text}</p></${action?'button':'div'}>`}
function growthText(h){return h.effects?.length?h.effects.map(([k,n])=>STAT_NAMES[k]+' '+(n>0?'+':'')+n).join(' · '):'능력치 변화 없음'}
function eventView(){const e=eventOf(g),peer=peerOf(g),parts=dialogueParts(e),result=g.phase==='result';let inside;if(result){const h=g.history.at(-1);inside=`<div class="two-talk">${talkCard(peer.name,face(peer),'“'+esc(h.reaction)+'”')}${talkCard(g.profile.name,'<span class="thought-symbol">나</span>','<strong>나의 선택: '+esc(h.choice)+'</strong><br>('+esc(h.result)+')',true)}</div><div class="growth-feedback">${growthText(h)}</div><div class="popup-options">${btn('계속하기 →','next')}<button class="feedback-link" data-action="feedback">비슷한 경험이 있나요?</button></div>`}else{const last=g.beat>=parts.length;const visible=parts.slice(0,Math.min(g.beat+1,parts.length));const spoken=visible.filter(p=>p.spoken).at(-1),thought=visible.filter(p=>!p.spoken).at(-1);let who=spoken?.speaker||peer.name;const role=who==='조교'?'instructor':who==='교관'?'teacher':null;const otherPhoto=role?face(0,role):face(peer);inside=`<div class="two-talk">${talkCard(who,otherPhoto,spoken?'“'+esc(spoken.text)+'”':'…',false,last?null:'v2-beat')}${talkCard(g.profile.name,'<span class="thought-symbol">나</span>',last?'(어떻게 할까?)':'('+esc(thought?.text||'상대의 말을 듣는다.')+')',true,last?null:'v2-beat')}</div><div class="dialogue-navigation"><button class="chip" data-action="dialogue-back" ${g.beat===0?'disabled':''}>‹ 이전 대사</button><span>${last?'선택지를 눌러주세요':'어느 대화창이든 터치 · 다음 ▸'}</span></div>${last?`<div class="popup-options">${e.choices.map((c,i)=>`<button class="choice" data-choice="${i}">${esc(c.text)}</button>`).join('')}</div>`:''}`}
return popup(e.title,e.scene,inside,result)}
function trainingView(){const q=questionFor(g),teacher=INSTRUCTORS[g.trainingIndex%2],stage=g.trainingBeat;const otherText=g.mini?q.explain:stage===0?'오늘은 '+q.type+' 교육입니다.':stage===1?q.teach:q.question;const mineText=g.mini?(g.mini.skipped?'(해설을 보고 복습했다.)':'내가 고른 답: '+esc(q.options[g.mini.answerIndex]||'')):stage<2?'(조교의 설명을 듣는다.)':'(배운 내용을 떠올려 보자.)';let html=`<div class="two-talk">${talkCard(teacher.name+' '+teacher.rank,face(g.trainingIndex%2,'instructor'),'“'+esc(otherText)+'”',false,!g.mini&&stage<2?'training-beat':null)}${talkCard(g.profile.name,'<span class="thought-symbol">나</span>',mineText,true,!g.mini&&stage<2?'training-beat':null)}</div>`;if(!g.mini){html+=stage<2?`<div class="dialogue-navigation"><button class="chip" data-action="training-back" ${stage===0?'disabled':''}>‹ 이전 대사</button><span>대화창 터치 · 다음 ▸</span></div>`:`<div class="popup-options">${q.options.map((o,i)=>`<button class="choice" data-question="${i}">${esc(o)}</button>`).join('')}</div><div class="dialogue-navigation"><button class="plain" data-action="training-back">‹ 설명 다시 읽기</button><button class="plain" data-action="v2-skip-quiz">해설 보기</button></div>`}else html+=`<div class="quiz-explain"><strong>${g.mini.correct?'✓ 정답':g.mini.skipped?'함께 복습했습니다':'정답: '+esc(q.options[q.answer])}</strong></div><div class="growth-feedback">${g.mini.change?STAT_NAMES[g.mini.stat]+' +'+g.mini.change:'능력치 변화 없음'}</div><details class="question-source"><summary>교육 자료</summary><p>${esc(q.basis)} · ${esc(q.year)}</p><a href="${esc(q.source)}" target="_blank" rel="noopener">참고자료 ↗</a></details><div class="popup-options">${btn('교육 마치기 →','training-end')}</div>`;return popup(q.type,'classroom',html,!!g.mini)}
