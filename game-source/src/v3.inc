let lastScreen='',lockedScroll=null;
function render(){clearInterval(clock);const pageY=window.scrollY||0,logY=$('.day-logs')?.scrollTop||0;document.documentElement.classList.add('has-portraits');const body=screen==='home'?home():screen==='setup'?setup():screen==='quiz'?quiz():game();$('#app').innerHTML=`<div class="wrap ${g?.settings.large?'large-text':''}">${header()}${body}${screen==='game'?'':footer()}</div>`;document.querySelectorAll('canvas').forEach(c=>drawScene(c,c.dataset.scene,g?.season??2,g?.day??5));if(screen==='setup')bindForm();armedAt=performance.now()+300;const overlay=screen==='game'&&(['event','result','training','medical'].includes(g?.phase)||(g?.phase==='timeline'&&!g.tutorialDone));if(overlay){if(lockedScroll===null)lockedScroll=pageY;document.body.style.position='fixed';document.body.style.top=`-${lockedScroll}px`;document.body.style.width='100%'}else if(lockedScroll!==null){const y=lockedScroll;lockedScroll=null;document.body.style.position='';document.body.style.top='';document.body.style.width='';window.scrollTo(0,y)}else if(lastScreen!==screen){window.scrollTo(0,0)}else window.scrollTo(0,pageY);lastScreen=screen;if($('.day-logs'))$('.day-logs').scrollTop=logY;if(g?.phase==='timeline'&&g.autoplay&&g.tutorialDone&&screen==='game')clock=setInterval(()=>{if(!$('#modal-root').firstChild)tick()},Math.round(2200/(g.speed||1)))}
function game(){if(!g)return home();if(g.phase==='notice')return notice();if(g.phase==='arrival')return arrival();if(g.phase==='focus')return focus();if(g.phase==='ending')return ending();return `<main class="timeline-page">${clockbar()}${growthPanel()}${timeline()}${['event','result'].includes(g.phase)?eventView():g.phase==='training'?trainingView():g.phase==='medical'?medicalView():!g.tutorialDone?tutorialView():''}</main>`}
function eventLines(e){return dialogueParts(e).map(p=>p.text)}
function dialogueParts(e){const out=[];for(const raw of e.lines){const line=textFor(g,raw);const pieces=line.split(/“([^”]*)”/);let speaker=line.includes('조교')?'조교':line.includes('교관')?'교관':peerOf(g).name;pieces.forEach((t,i)=>{if(!t.trim())return;const spoken=i%2===1;const sentences=t.split(/(?<=[.!?])\s+/);for(let text of sentences){while(text.length>65){let cut=text.lastIndexOf(' ',62);if(cut<15)cut=62;out.push({text:text.slice(0,cut),spoken,speaker});text=text.slice(cut).trim()}if(text.trim())out.push({text:text.trim(),spoken,speaker})}})}return out}
function eventView(){const e=eventOf(g),peer=peerOf(g),parts=dialogueParts(e),result=g.phase==='result';let inside;if(result){const h=g.history.at(-1);inside=`<div class="popup-person">${face(peer)}<strong>${peer.name}</strong></div><div class="popup-copy"><p>(${esc(h.result)})</p><p>“${esc(h.reaction)}”</p></div><div class="growth-feedback">${STAT_NAMES[h.growth[0]]} +${h.growth[1]}</div><div class="popup-options">${btn('계속하기 →','next')}<button class="feedback-link" data-action="feedback">비슷한 경험이 있나요?</button></div>`}else{const last=g.beat>=parts.length,p=parts[g.beat];const narrator=last||!p.spoken;const instructor=p?.speaker==='조교'||p?.speaker==='교관';const portraitHtml=narrator?'<span class="thought-symbol">···</span>':instructor?face(0,p.speaker==='조교'?'instructor':'teacher'):face(peer);inside=`<button class="touch-dialogue" data-action="v2-beat" ${last?'disabled':''} aria-label="다음 대사"><div class="popup-person">${portraitHtml}<strong>${narrator?g.profile.name+' · 생각':p.speaker}</strong></div><p class="popup-line ${narrator?'inner-thought':''}">${last?'(어떻게 할까?)':narrator?'('+esc(p.text)+')':'“'+esc(p.text)+'”'}</p><span class="touch-hint">${last?'선택지를 눌러주세요':'대화창 터치 · 다음 ▸'}</span></button><div class="dialogue-navigation"><button class="chip" data-action="dialogue-back" ${g.beat===0?'disabled':''}>‹ 이전 대사</button><span>${Math.min(g.beat+1,parts.length)} / ${parts.length}</span></div>${last?`<div class="popup-options">${e.choices.map((c,i)=>`<button class="choice" data-choice="${i}">${esc(c.text)}</button>`).join('')}</div>`:''}`}
return popup(e.title,e.scene,inside,result)}
function popup(title,sceneType,html,result=false){return `<div class="event-overlay"><section class="event-popup ${result?'is-result':''}" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="event-title"><span>${g.elapsed+1}일째 · ${esc(title)}</span><small>시간 멈춤</small></div>${scene(sceneType,title,'popup-scene')}<div class="popup-body">${html}</div></section></div>`}
function trainingView(){const q=questionFor(g);const teacher=INSTRUCTORS[g.trainingIndex%2],stage=g.trainingBeat;const person=`<div class="popup-person">${face(g.trainingIndex%2,'instructor')}<strong>${teacher.name} ${teacher.rank}</strong></div>`;let html;if(!g.mini){html=person+(stage<2?`<button class="touch-dialogue" data-action="training-beat"><p class="popup-line">${stage===0?'“오늘은 '+esc(q.type)+' 교육입니다.”':'“'+esc(q.teach)+'”'}</p><span class="touch-hint">터치하면 다음 ▸</span></button><div class="dialogue-navigation"><button class="chip" data-action="training-back" ${stage===0?'disabled':''}>‹ 이전 대사</button><span>${stage+1} / 2</span></div>`:`<div class="popup-copy"><strong>${esc(q.question)}</strong></div><div class="popup-options">${q.options.map((o,i)=>`<button class="choice" data-question="${i}">${esc(o)}</button>`).join('')}</div><button class="plain" data-action="training-back">‹ 설명 다시 읽기</button><button class="plain" data-action="v2-skip-quiz">해설을 보고 복습하기</button>`)}else html=person+`<div class="quiz-explain"><strong>${g.mini.correct?'✓ 정답':g.mini.skipped?'함께 복습했습니다':'정답을 확인해 봅시다'}</strong><p>${esc(q.explain)}</p><p>정답: ${esc(q.options[q.answer])}</p></div><div class="growth-feedback">${STAT_NAMES[g.mini.stat]} +${g.mini.change}</div><details class="question-source"><summary>교육 자료</summary><p>${esc(q.basis)}<br>${esc(q.year)}</p><a href="${esc(q.source)}" target="_blank" rel="noopener">공개 참고자료 ↗</a></details><div class="popup-options">${btn('교육 마치기 →','training-end')}</div>`;return popup(q.type,'classroom',html,!!g.mini)}
function medicalView(){const html=g.medicalResult?`<div class="popup-person">${face(0,'instructor')}<strong>${INSTRUCTORS[0].name} 상병</strong></div><div class="popup-copy"><p>(${g.medicalResult.text})</p><p>“불편한 곳이 있으면 바로 알립니다.”</p></div><div class="growth-feedback">피로 ${g.medicalResult.change}</div><div class="popup-options">${btn('일정으로 돌아가기 →','medical-end')}</div>`:`<div class="popup-person">${face(0,'instructor')}<strong>${INSTRUCTORS[0].name} 상병</strong></div><div class="popup-copy"><p>“오늘 많이 지쳐 보입니다. 몸 상태는 어떻습니까?”</p><p>(피로가 쌓였다. 지금 내 상태를 먼저 살펴야겠다.)</p></div><div class="popup-options">${['상태를 알리고 진료를 요청한다','조교와 상의하고 휴식을 취한다','불편한 곳을 구체적으로 설명한다'].map((t,i)=>`<button class="choice" data-medical="${i}">${t}</button>`).join('')}</div>`;return popup('몸 상태를 먼저 확인하자','barracks',html,!!g.medicalResult)}
const TUTORIAL=[['나의 첫날','상단에 전역·수료 D-day와 능력치가 표시됩니다. 피로가 쌓이면 회복과 도움 요청도 필요합니다.'],['개인정비 시간 목표 고르기','아래 활동 중 하나를 눌러보세요. 이 선택은 매일 적용되며, 언제든 바꿀 수 있습니다. 훈련소에서 주특기 적성은 변하지 않습니다.'],['시간을 보내는 방법','다음 날은 하루씩, 자동 진행은 선택한 배속으로 날짜를 넘깁니다. 다음 사건까지 버튼으로 평범한 날을 건너뛸 수도 있습니다.'],['사건을 만났다면','사건 중에는 시간이 멈춥니다. 대화창을 터치해 읽고, 이전 대사로 돌아갈 수 있습니다. 일반 선택에는 정답이 없고 교육 문제만 정답이 있습니다. 진행은 자동 저장됩니다.']];
function tutorialView(){const step=g.tutorialStep||0,t=TUTORIAL[step];return `<div class="event-overlay"><section class="event-popup tutorial" role="dialog" aria-modal="true" aria-label="첫날 조작 안내"><div class="event-title"><span>첫날 안내 · ${step+1}/4</span><button class="skip-guide" data-action="tutorial-skip">안내 건너뛰기 ×</button></div><div class="popup-body"><h2>${t[0]}</h2><p class="popup-line">${t[1]}</p>${step===1?`<div class="chips tutorial-goals">${[['rest','휴식'],['train','체력단련'],['study','복습'],['talk','동기와 대화']].map(([k,n])=>`<button class="chip ${g.dayPlan===k?'active':''}" data-tutorial-goal="${k}">${n}</button>`).join('')}</div>`:''}<div class="popup-options"><button class="btn primary" data-action="tutorial-next" ${step===1&&!g.tutorialPlanSet?'disabled':''}>${step===3?'시작하기 →':'다음 →'}</button>${step>0?'<button class="plain" data-action="tutorial-back">‹ 이전 안내</button>':''}</div></div></section></div>`}
function processDay(){const next=dayForward(g);if(next==='event')selectEvent(g);else if(next==='training')beginTraining(g);else if(next==='medical')beginMedical(g);return next}
function tick(){if(g?.phase!=='timeline'||!g.tutorialDone)return;processDay();save();render()}
Object.assign(actions,{'dialogue-back':()=>{if(g.phase==='event'&&g.beat>0){g.beat--;save();render()}},'training-beat':()=>{if(g.phase==='training'&&g.trainingBeat<2&&performance.now()>=armedAt){g.trainingBeat++;save();render()}},'training-back':()=>{if(g.phase==='training'&&!g.mini){g.trainingBeat=Math.max(0,g.trainingBeat-1);save();render()}},'training-end':()=>{endTraining(g);save();render()},'medical-end':()=>{if(g.medicalResult){g.phase='timeline';save();render()}},'tutorial-skip':()=>{g.tutorialDone=true;save();render()},'tutorial-next':()=>{if((g.tutorialStep||0)>=3)g.tutorialDone=true;else g.tutorialStep=(g.tutorialStep||0)+1;save();render()},'tutorial-back':()=>{g.tutorialStep=Math.max(0,(g.tutorialStep||0)-1);save();render()},guide:()=>{if(screen==='game'&&g?.phase==='timeline'){g.tutorialDone=false;g.tutorialStep=0;save();render()}else modal('<h2>플레이 안내</h2><p>입영 후 첫날에 조작 안내를 볼 수 있습니다. 타임라인에서는 생활 목표를 정하고 날짜를 넘깁니다. 사건 중에는 대화를 터치하고 선택합니다.</p>'+btn('닫기','close'))},'skip-days':()=>{if(!g.tutorialDone)return;for(let i=0;i<36&&g.phase==='timeline';i++){const next=processDay();if(next!=='day')break}save();render()},'v2-skip-quiz':()=>{if(g.phase==='training'){quizAnswer(g,-1);g.mini.skipped=true;save();render()}}});
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;if(t.dataset.medical!==undefined&&g.phase==='medical'&&performance.now()>=armedAt){medicalChoice(g,+t.dataset.medical);save();render()}if(t.dataset.tutorialGoal){g.dayPlan=t.dataset.tutorialGoal;g.tutorialPlanSet=true;save();render()}});
