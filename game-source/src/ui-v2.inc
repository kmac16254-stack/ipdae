// v0.2: daily timeline and touch-first event overlay.
let clock=null,armedAt=0;
function growthPanel(){return `<section class="growth-strip">${Object.entries(STAT_NAMES).map(([key,label])=>`<div><span>${label}${key==='aptitude'?' · 고정':''}</span><strong>${g.stats[key]}</strong><progress max="100" value="${g.stats[key]}"></progress></div>`).join('')}</section><div class="fatigue">피로 ${g.fatigue}/100 · ${g.fatigue>70?'회복이 필요합니다':'몸 상태를 살피며 진행하세요'}</div>`}
function clockbar(){return `<div class="clockbar"><div><strong>입대 ${Math.min(g.elapsed+1,35)}일째</strong><small>${dateAt(g).replaceAll('-','.')} · ${g.week}주차</small></div><div class="countdown"><strong>전역 D-${dischargeDays(g)}</strong><small>${g.dates.discharge.replaceAll('-','.')} · 수료까지 ${Math.max(0,34-g.elapsed)}일</small></div></div>`}
function home(){return `<main class="simple-home"><h1>입대할게요</h1>${scene('gate','나의 군 생활 시작하기')}<div class="hero-actions">${btn('새로 입대하기 →','new')}${saved?btn('이어 하기 →','continue','secondary'):''}</div><p class="tiny">베타 · 훈련소 수료까지 플레이 · 자동 저장</p></main>`}
function render(){clearInterval(clock);const body=screen==='home'?home():screen==='setup'?setup():screen==='quiz'?quiz():game();$('#app').innerHTML=`<div class="wrap ${g?.settings.large?'large-text':''}">${header()}${body}${screen==='game'?'':footer()}</div>`;document.querySelectorAll('canvas').forEach(c=>drawScene(c,c.dataset.scene,g?.season??2,g?.day??5));if(screen==='setup')bindForm();armedAt=performance.now()+350;if(g?.phase==='timeline'&&g.autoplay&&screen==='game')clock=setInterval(()=>{if(!$('#modal-root').firstChild)tick()},Math.round(2200/(g.speed||1)));window.scrollTo(0,0)}
function game(){if(!g)return home();if(g.phase==='notice')return notice();if(g.phase==='arrival')return arrival();if(g.phase==='focus')return focus();if(g.phase==='ending')return ending();return `<main class="timeline-page">${clockbar()}${growthPanel()}${timeline()}${['event','result'].includes(g.phase)?eventView():''}</main>`}
function notice(){return `<main class="content compact-notice"><div class="letter"><div class="dossier-label">입영통지서 · 이야기 속 문서</div><h2>현역병 입영통지서</h2><div class="record-row"><span>성명</span><strong>${esc(g.profile.name)}</strong></div><div class="record-row"><span>입영일</span><strong>${g.dates.start}</strong></div><div class="record-row"><span>입영부대</span><strong>${esc(g.route.training)}</strong></div><div class="record-row"><span>소재지</span><strong>${esc(g.route.place)}</strong></div><div class="record-row"><span>전역 예정일</span><strong>${g.dates.discharge}</strong></div><p class="tiny">육군 복무기간 21개월 · 게임상 사단 직접 입영으로 각색</p></div><div class="choices">${['가족에게 먼저 말한다','친구에게 연락한다','혼자 준비물을 적는다'].map((x,i)=>`<button class="choice" data-prologue="${i}">${x}</button>`).join('')}</div></main>`}
function arrival(){return `<main class="content">${scene('gate',g.route.training)}<div class="dialogue"><h2>진짜, 왔다.</h2><p>${esc(g.prologueText)}</p><p>${g.profile.age>=25?'나이가 조금 많아도, 오늘은 모두 처음이다.':'비슷한 나이인데도 먼저 말 걸기는 어렵다.'}</p><p class="tiny">${esc(g.route.place)} · ${esc(g.route.name)}</p></div><div class="hero-actions">${btn('생활관으로 →','arrival-next')}</div></main>`}
function timeline(){const w=WEEKS[g.week-1];return `<section class="timeline-shell"><div class="timeline-top"><div><span class="eyebrow">${g.week}주차 일정</span><h2>${w.title}</h2></div><button class="chip" data-action="squad">분대원</button></div><p class="week-schedule">${w.schedule.join(' · ')}</p><div class="daily-plan"><label>개인정비 시간</label><div class="chips">${[['rest','휴식'],['train','체력단련'],['study','복습'],['talk','동기와 대화']].map(([key,t])=>`<button class="chip ${g.dayPlan===key?'active':''}" data-daily-plan="${key}">${t}</button>`).join('')}</div></div><div class="day-logs" role="log" aria-label="나의 군 생활 기록">${g.logs.length?g.logs.slice().reverse().slice(0,18).map(l=>`<article class="log-entry ${l.kind}"><span>${l.day}일째</span><div><p>${esc(l.text)}</p>${l.kind==='schedule'?`<small>${w.schedule.join(' · ')}</small>`:''}${l.effects?.length?`<small>${l.effects.map(([key,n])=>STAT_NAMES[key]+' '+(n>=0?'+':'')+n).join(' · ')}</small>`:''}</div></article>`).join(''):'<article class="log-entry"><span>1일째</span><div><p>생활관에 도착했다. 낯선 얼굴 아홉 명이 나를 본다.</p></div></article>'}</div><div class="timeline-controls">${btn('다음 날 →','tick')}<button class="btn secondary" data-action="auto">${g.autoplay?'❚❚ 일시정지':'▶ 자동 진행'}</button><button class="chip" data-action="speed">${g.speed||1}×</button><button class="plain" data-action="skip-days">다음 사건까지 »</button></div></section>`}
function eventLines(e){return e.lines.flatMap(t=>textFor(g,t).split(/(?<=[.!?。])\s+/)).flatMap(t=>{const out=[];while(t.length>62){let p=t.lastIndexOf(' ',60);if(p<15)p=60;out.push(t.slice(0,p));t=t.slice(p).trim()}if(t)out.push(t);return out})}
function face(m,role='peer'){const index=role==='peer'?g.squad.findIndex(x=>x.id===m.id):role==='instructor'?9+(m||0):11;return `<span class="photo-face" style="--face-x:${(index%4)*100/3}%;--face-y:${Math.floor(index/4)*50}%"><img class="fallback-face" src="${portrait(role==='peer'?m.look:21,role!=='peer')}" alt=""></span>`}
function eventView(){const e=eventOf(g),peer=peerOf(g),lines=eventLines(e),result=g.phase==='result';let inside='';if(result){const h=g.history.at(-1);if(!g.mini){const q=questionFor(g);inside=`<div class="popup-person">${face(0,'teacher')}<div><strong>${TRAINERS[g.week-1].name}</strong><small>${q.type}</small></div></div><div class="popup-copy"><p>${esc(q.teach)}</p><strong>${esc(q.question)}</strong></div><div class="popup-options">${q.options.map((o,i)=>`<button class="choice" data-question="${i}">${o}</button>`).join('')}</div><button class="plain" data-action="v2-skip-quiz">해설을 보고 복습하기</button>`}else{const q=questionFor(g);inside=`<div class="popup-person">${face(peer)}<div><strong>${peer.name}</strong><small>${affinityLabel(peer)}</small></div></div><div class="popup-copy"><p>${esc(h.result)}</p><p>“${esc(h.reaction)}”</p></div><div class="quiz-explain"><strong>${g.mini.correct?'✓ 정답':'함께 복습했습니다'}</strong><p>${q.explain}</p><small>${STAT_NAMES[g.mini.stat]} +${g.mini.change} · ${STAT_NAMES[h.growth[0]]} +${h.growth[1]}</small></div><div class="popup-options">${btn('기록하고 계속하기 →','next')}<button class="feedback-link" data-action="feedback">비슷한 경험이 있나요?</button></div>`}}else{const last=g.beat>=lines.length;inside=`<button class="touch-dialogue" data-action="v2-beat" ${last?'disabled':''} aria-label="다음 대사"><div class="popup-person">${face(peer)}<div><strong>${g.beat%2?peer.name:g.profile.name}</strong><small>${e.title}</small></div></div><p class="popup-line">${esc(last?'어떻게 할까?':lines[g.beat])}</p><span class="touch-hint">${last?'선택지를 눌러주세요':'대화창을 터치하면 다음 대사 ▸'}</span></button>${last?`<div class="popup-options">${e.choices.map((c,i)=>`<button class="choice" data-choice="${i}">${esc(c.text)}</button>`).join('')}</div>`:''}`}
return `<div class="event-overlay"><section class="event-popup" role="dialog" aria-modal="true" aria-label="${esc(e.title)}"><div class="event-title"><span>${g.elapsed+1}일째 · ${e.title}</span><small>시간 멈춤</small></div>${scene(e.scene,e.title,'popup-scene')}<div class="popup-body">${inside}</div></section></div>`}
function tick(){if(g?.phase!=='timeline')return;const next=dayForward(g);if(next==='event'){selectEvent(g)}save();render()}
Object.assign(actions,{tick,'auto':()=>{g.autoplay=!g.autoplay;save();render()},speed:()=>{g.speed=g.speed===4?1:(g.speed||1)*2;save();render()},'skip-days':()=>{for(let i=0;i<36&&g.phase==='timeline';i++){const next=dayForward(g);if(next==='event'){selectEvent(g);break}}save();render()},'v2-beat':()=>{if(performance.now()<armedAt||g.phase!=='event')return;const e=eventOf(g);if(g.beat<eventLines(e).length){g.beat++;save();render()}},'v2-skip-quiz':()=>{quizAnswer(g,-1);save();render()}});
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;if(t.dataset.dailyPlan){g.dayPlan=t.dataset.dailyPlan;save();render()}if(t.dataset.question!==undefined&&!g.mini&&performance.now()>=armedAt){quizAnswer(g,+t.dataset.question);save();render()}});
document.addEventListener('keydown',e=>{if($('#modal-root').firstChild)return;if(g?.phase==='event'&&['Enter',' '].includes(e.key)&&document.activeElement.tagName==='BODY'){e.preventDefault();actions['v2-beat']()}if(g?.phase==='event'&&g.beat>=eventLines(eventOf(g)).length&&['1','2','3'].includes(e.key)&&performance.now()>=armedAt){applyChoice(g,Number(e.key)-1);save();render()}});
